# Local testing only — CI injects these via Doppler instead.
# Copy to .env (gitignored); scripts/claude-review.sh sources it.

# Claude API key used by the claude CLI. Optional locally if `claude` is
# already logged in; required in CI.
ANTHROPIC_API_KEY=

# GitHub token for gh (PR read + comment write). Optional locally if
# `gh auth login` has been run.
GH_TOKEN=
