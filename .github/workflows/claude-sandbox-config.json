{
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "/home/runner/work/_temp",
        "/home/runner/work/**/.git/config"
      ]
    },
    "credentials": {
      "envVars": [
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" }
      ]
    },
    "network": { "strictAllowlist": true, "allowedDomains": [] }
  },
  "permissions": {
    "deny": [
      "Read(//home/runner/work/**/.git/**)",
      "Grep(//home/runner/work/**/.git/**)",
      "Glob(//home/runner/work/**/.git/**)",
      "Read(//proc/**)",
      "Read(//sys/**)",
      "Read(//home/runner/work/_temp/**)",
      "Read(//home/runner/.config/**)",
      "Grep(//proc/**)",
      "Grep(//sys/**)",
      "Grep(//home/runner/work/_temp/**)",
      "Grep(//home/runner/.config/**)",
      "Glob(//proc/**)",
      "Glob(//sys/**)",
      "Glob(//home/runner/work/_temp/**)",
      "Glob(//home/runner/.config/**)"
    ]
  }
}
